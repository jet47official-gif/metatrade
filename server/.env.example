# Meta Trade server configuration
# Copy this file to .env and fill in real values.

# Port the API listens on
PORT=5000

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret

# JWT token lifetime
JWT_EXPIRES_IN=7d

# MongoDB connection string.
# Leave UNSET for local development - an in-memory database is used automatically.
# For production on Render, set your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/metatrade

# Environment (development | production)
NODE_ENV=production
